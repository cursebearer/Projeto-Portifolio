%%{init: {'theme':'base','themeVariables':{'primaryColor':'#fff','primaryTextColor':'#0b1320','primaryBorderColor':'#1f3b73','lineColor':'#1f3b73','fontSize':'15px'}}}%%
graph TB
    Entrada([Acesso ao Sistema]):::entry

    subgraph Pub["Rotas Públicas — sem autenticação"]
        direction LR
        Login["/login<br/><i>Autenticar</i>"]:::pub
        Register["/register<br/><i>Criar conta</i>"]:::pub
        VerifyPub["/verify<br/><i>Verificação pública<br/>de documento</i>"]:::pub
    end

    subgraph Priv["Rotas Protegidas — cookie httpOnly válido"]
        direction TB
        Dashboard["/dashboard<br/><i>Lista de documentos<br/>+ estatísticas</i>"]:::priv
        Upload["/upload<br/><i>Novo registro<br/>on-chain</i>"]:::priv
        DocDetail["/documents/[id]<br/><i>Detalhe + verificação<br/>+ download + excluir</i>"]:::priv
    end

    Entrada --> Login
    Entrada --> VerifyPub
    Login <-->|"link 'Criar conta'"| Register
    Register -->|"auto-login (cookie)"| Dashboard
    Login -->|"Set-Cookie httpOnly"| Dashboard
    Dashboard --> Upload
    Dashboard --> DocDetail
    Upload -->|"sucesso → ver no dashboard"| Dashboard
    DocDetail -->|"DELETE → soft-delete"| Dashboard
    Dashboard -->|"logout (cookie Max-Age=0)"| Login

    Guard{{"Next.js Middleware<br/>checa cookie access_token<br/>presente"}}:::guard
    Guard -.->|"ausente → redirect"| Login
    Priv -.->|"cada navegação"| Guard

    classDef entry fill:#fdf6e3,stroke:#8a6d3b,stroke-width:2px,color:#0b1320
    classDef pub fill:#e8f4ff,stroke:#1f3b73,stroke-width:2px,color:#0b1320
    classDef priv fill:#e3fae3,stroke:#2e6b3c,stroke-width:2px,color:#0b1320
    classDef guard fill:#fff0f0,stroke:#a33,stroke-width:2px,color:#0b1320,font-style:italic
