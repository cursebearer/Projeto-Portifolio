flowchart TB
    Start([Visitante acessa /verify]):::start
    Mode{Modo de entrada}:::decision
    Upload["Upload de arquivo<br/>(frontend calcula SHA-256<br/>no navegador via WebCrypto)"]:::step
    Paste["Cola hash SHA-256<br/>(64 chars hex)"]:::step
    ValidateFmt{"RF19 — formato válido?<br/>regex ^[a-fA-F0-9]{64}$"}:::decision
    BadReq([400 Bad Request<br/>'Hash inválido']):::error
    Call["GET /verify/public/{hash}"]:::step
    Chain["BlockchainService.verifyDocument(hash)<br/>eth_call à Sepolia<br/>(view, sem custo)"]:::step
    Found{"Existe<br/>on-chain?"}:::decision
    AuditOk["INSERT VerificationAttempt<br/>source=PUBLIC, found=true<br/>ipAddress, userAgent"]:::step
    AuditFail["INSERT VerificationAttempt<br/>source=PUBLIC, found=false<br/>ipAddress, userAgent"]:::step
    Auth([Card verde 'Autêntico'<br/>+ registeredAt, registeredBy,<br/>blockNumber, network]):::done
    NotFound([Card cinza 'Não encontrado'<br/>'Documento não consta na blockchain']):::warn

    Start --> Mode
    Mode -- "arquivo" --> Upload
    Mode -- "hash" --> Paste
    Upload --> Call
    Paste --> ValidateFmt
    ValidateFmt -- "não" --> BadReq
    ValidateFmt -- "sim" --> Call
    Call --> Chain --> Found
    Found -- "sim" --> AuditOk --> Auth
    Found -- "não" --> AuditFail --> NotFound

    classDef start fill:#fdf6e3,stroke:#8a6d3b,stroke-width:2.5px,color:#0b1320
    classDef step fill:#e8f4ff,stroke:#1f3b73,stroke-width:2.5px,color:#0b1320
    classDef decision fill:#fff7e0,stroke:#a06b00,stroke-width:2.5px,color:#0b1320
    classDef error fill:#ffe0e0,stroke:#a33,stroke-width:2.5px,color:#0b1320
    classDef done fill:#e3fae3,stroke:#2e6b3c,stroke-width:2.5px,color:#0b1320
    classDef warn fill:#f5f5f5,stroke:#666,stroke-width:2.5px,color:#0b1320
