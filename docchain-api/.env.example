# ─────────── Database ───────────
DATABASE_URL="postgresql://docchain:docchain@localhost:5432/docchain?schema=public"

# ─────────── Auth / JWT ───────────
# Gerar: openssl rand -hex 32
JWT_SECRET="troque-por-string-aleatoria-de-no-minimo-32-chars"
JWT_EXPIRES_IN="15m"

# ─────────── Cripto AES-256-GCM ───────────
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="troque-por-32-bytes-em-hex-64-chars"

# ─────────── Blockchain (Sepolia) ───────────
# Reutiliza credenciais do docchain-contracts/.env
RPC_URL="https://eth-sepolia.g.alchemy.com/v2/SUA_API_KEY"
PRIVATE_KEY="0x_sua_private_key_wallet_deploy"
CONTRACT_ADDRESS="0xEC85EB9bE437EeBA80ac1014dFf127615B20B88e"
NETWORK="sepolia"

# ─────────── Storage ───────────
STORAGE_TYPE="LOCAL"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# ─────────── App ───────────
PORT=3000
NODE_ENV="development"
